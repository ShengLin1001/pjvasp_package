#!/bin/bash
# J. Pei, 2026-11-01
# pei_lmp_univ_sbatch -- run ONE LAMMPS case inside an existing Slurm allocation.
#
# LAMMPS counterpart of pei_vasp_univ_sbatch, with the exit-code contract the submit engine
# (mymetal.slurm.submit) reads:
#     0   completed in this run
#     10  already completed, skipped (nothing is touched)
#     1   failed or missing input
#
# A case is complete when y_lmp_done.txt exists: the inputs rendered by
# mymetal.build.workflow.lammps_input write it as their very last command, after the energy
# line and the final dump. LAMMPS overwrites log / print-file / dump outputs on a rerun, so
# an unfinished case is simply run again -- nothing has to be deleted first.
#
# Usage:
#     pei_lmp_univ_sbatch [dir] [lmp_exe] [extra lmp args ...]
#     pei_lmp_univ_sbatch .                          # relaxation case (y_dir/<case>)
#     pei_lmp_univ_sbatch . lmp -partition 7x1       # NEB in y_neb/y_dir, 5 images + 2 ends
#
# The launcher comes from MY_LAUNCHER (default srun), exactly as for the VASP runner, e.g.
#     export MY_LAUNCHER="pei_slurm_univ_launch_retry srun -n $SLURM_NTASKS"

DONE_MARKER="y_lmp_done.txt"
INPUT="lmp.in"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

launcher="${MY_LAUNCHER:-srun}"
job_dir="$(realpath "${1:-.}")"
lmp_exe="${2:-lmp}"
# drop dir / exe; whatever is left goes to lmp before -in (e.g. -partition 7x1)
if [[ $# -ge 2 ]]; then shift 2; else shift $#; fi
lextra=("$@")

echo ""
echo "================ 📁 $job_dir"
if ! cd "$job_dir"; then
    echo "❌ ERROR: cannot enter directory: $job_dir" >&2
    exit 1
fi
echo "📍 Current dir: $(pwd)"

if [[ -f "$DONE_MARKER" ]]; then
    echo "✅ Calculation completed successfully, skipping..."
    exit 10
fi
if [[ ! -f "$INPUT" ]]; then
    echo "❌ ERROR: no $INPUT in $job_dir" >&2
    exit 1
fi

# $launcher stays unquoted on purpose: it is a command prefix such as
# "pei_slurm_univ_launch_retry srun -n 1" and must split into words.
echo "▶️  $launcher $lmp_exe ${lextra[*]} -in $INPUT"
$launcher "$lmp_exe" "${lextra[@]}" -in "$INPUT"
rc=$?

if [[ -f "$DONE_MARKER" ]]; then
    echo "✅ Calculation completed (exit code $rc)"
    exit 0
fi
echo "❌ Calculation not completed: no $DONE_MARKER (exit code $rc)" >&2
exit 1
