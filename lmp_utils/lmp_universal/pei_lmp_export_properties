#!/usr/bin/env python3
"""Export attribute-specific FCC/HCP structures; never submit DFT."""

import argparse
from pathlib import Path
import sys

from mymetal.post.property import export_property_structures

sys.stdout.reconfigure(line_buffering=True)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('-path_root', type=Path, required=True)
parser.add_argument('-path_out', type=Path, required=True)
parser.add_argument('-elements', nargs='+', required=True)
parser.add_argument('-run', required=True)
parser.add_argument('-epoch', type=int, required=True)
parser.add_argument('-round_id', default=None)
parser.add_argument('-strain_points', type=int, default=5,
                    help='Odd selected count per mode; 0 exports the whole scan.')
parser.add_argument('-path_vasp_static', type=Path, default=None,
                    help='Optional static template; generate input only, never submit.')
args = parser.parse_args()
print('📁 source: ' + str(args.path_root))
print('📁 export: ' + str(args.path_out))
print('📍 run/epoch: ' + args.run + '/' + str(args.epoch))
export_property_structures(path_root=args.path_root, path_out=args.path_out,
                           lele=args.elements, run=args.run, epoch=args.epoch,
                           round_id=args.round_id,
                           strain_points=None if args.strain_points == 0 else args.strain_points,
                           path_vasp_static=args.path_vasp_static)

