#!/usr/bin/env bash
# 常驻维护 zcm6 反向隧道（本地 7897 → ln2 127.0.0.1:37897）：断线后自动清理 ln2 上的残留会话再重连，Ctrl-C 停止。
# 隧道会话不开交互 shell，只在 ln2 跑一个带标记的等待循环。清理时按标记找到它的 sshd 父进程（即端口持有者）再 kill，
# 所以只会清掉本脚本建的隧道，不碰手动 ssh zcm6 / VS Code 的会话。
# 手动 ssh zcm6-proxy 留下的残留（@pts 会话）不自动清：脚本会一直等待并提示另开窗口跑 pei_ssh_univ_clean_zcm6_proxy。
# 用法（Windows git bash，ssh_utils/ 已在 ~/.bash_soft_env 加入 PATH）：pei_ssh_univ_keep_zcm6_proxy
# 开机自启：shell:startup\zcm6-proxy.lnk 运行 pei_ssh_univ_tray_zcm6_proxy.ps1，用隐藏的 mintty 窗口跑本脚本、右下角托盘留图标；托盘右键"退出"或关掉该窗口即停止

# 复用 clean 脚本的 HOST / PROXY_HOST / PORT / fail / warn / filter_ssh_noise / ssh_remote / get_local_proxy
source "$(dirname "${BASH_SOURCE[0]}")/pei_ssh_univ_clean_zcm6_proxy" || exit 1

# ponytail: 固定间隔、无限重试，不做指数退避；长时间断网时也只是每 15s 试一次
RETRY_SLEEP=${PEI_ZCM6_PROXY_RETRY_SLEEP:-15}
PID_FILE=/tmp/pei_ssh_univ_keep_zcm6_proxy.pid
MARKER=PEI_ZCM6_PROXY_TUNNEL=1
# 在 ln2 上由 "bash -c" 执行，命令行以 MARKER 开头供清理时识别。$PPID 是本会话的 sshd，它一退出循环就结束，不留孤儿进程
TUNNEL_CMD="$MARKER; "'echo "✅ 隧道已登录 $(hostname)，会话 sshd PID $PPID"; while kill -0 $PPID 2>/dev/null; do sleep 30; done'

# 只看本地 ssh 客户端不够：第二个实例若在第一个等待重试的空档启动，会通过客户端检查，
# 之后两边互相清理对方的隧道、反复抢端口。git bash 没有 flock，用 PID 文件 + /proc/<pid>/cmdline 防 PID 复用
check_single_instance() {
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    if [[ -n "$pid" ]] && grep -qa pei_ssh_univ_keep_zcm6_proxy "/proc/$pid/cmdline" 2>/dev/null; then
        fail "已有一个本脚本在运行（MSYS PID $pid；开机自启的在右下角托盘，单击 zcm6-proxy 图标显示窗口）"
    fi
    echo $$ > "$PID_FILE"
}

wait_retry() {
    warn "$1，${RETRY_SLEEP}s 后重试"
    sleep "$RETRY_SLEEP"
}

clean_remote() {
    # 输出被 kill 的 "KILL pid..."，以及清理后的 "LISTEN 0|1"
    ssh_remote "$PORT" "$MARKER" <<'EOF'
port=$1; marker=$2
lkill=()
# 锚定 "^bash -c"：本清理脚本走 stdin（bash -s），命令行里没有标记，不会把自己的会话匹配进来
for pid in $(pgrep -u "$USER" -f "^bash -c $marker"); do
    ppid=$(ps -o ppid= -p "$pid" | tr -d ' ')
    ps -o args= -p "$ppid" | grep -q '^sshd: ' && lkill+=("$ppid")
done
if (( ${#lkill[@]} > 0 )); then
    echo "KILL ${lkill[*]}"
    kill "${lkill[@]}"
    sleep 2
fi
if netstat -tln 2>/dev/null | grep -q "127.0.0.1:$port "; then echo "LISTEN 1"; else echo "LISTEN 0"; fi
EOF
}

main() {
    ### check: 本地已有本脚本或 zcm6-proxy 客户端（手动窗口）就不启动，否则两边抢端口、互相清理
    check_single_instance
    echo "================ 📍 检查本地 $PROXY_HOST 客户端"
    local local_proxy
    local_proxy=$(get_local_proxy)
    if [[ -n "$local_proxy" ]]; then
        echo "$local_proxy"
        fail "本地已有 $PROXY_HOST 在运行（上面第一列是 PID），先关掉它再启动本脚本"
    fi
    echo "✅ 本地没有 $PROXY_HOST 客户端"
    ### to here

    ### main: 清理 → 连接 → 断开后等待，循环直到 Ctrl-C
    trap 'echo; echo "🛑 已停止，隧道已关闭"; exit 0' INT
    local n=0 state rc
    while true; do
        n=$((n + 1))
        echo "================ 📍 [$(date '+%F %T')] 第 $n 次连接：清理 $HOST 上残留的隧道会话"
        if ! state=$(clean_remote); then
            wait_retry "ssh $HOST 失败（网络未恢复？）"
            continue
        fi
        sed -n 's/^KILL /🧹 已 kill 残留隧道 sshd PID: /p' <<<"$state"
        if grep -q '^LISTEN 1' <<<"$state"; then
            wait_retry "端口 $PORT 被非本脚本的会话占着（多半是手动 ssh $PROXY_HOST 的残留），请另开窗口运行 pei_ssh_univ_clean_zcm6_proxy"
            continue
        fi
        echo "================ ▶️  ssh $PROXY_HOST（保持本窗口打开，Ctrl-C 停止）"
        ssh "$PROXY_HOST" "$TUNNEL_CMD" 2> >(filter_ssh_noise)
        rc=$?
        wait_retry "[$(date '+%F %T')] 隧道断开（ssh 退出码 $rc）"
    done
    ### to here
}

# source 时不执行，便于单独调试各函数
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main; fi
