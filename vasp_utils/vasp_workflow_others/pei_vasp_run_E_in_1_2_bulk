#!/usr/bin/env python3
# B. Yin, 2022-03-09
# Revised by J. Pei, 2024-12-20
# Rewritten in Python by J. Pei, 2026-11-01 (same CLI and output; adds -calc / -pair /
#   -perturb / -outdir; the logic lives in mymetal.build.workflow.E_in_1_2_bulk)
# pei_vasp_run_E_in_1_2_bulk
#  >>> Uniaxial / biaxial in-plane stretch of a bulk cell. Run it at the level of
#      y_full_relax: a0 is the CONTCAR scale factor, x is stretched to a1, y to a2 (absolute
#      lengths in Angstrom), c is rescaled by 1/(strainx*strainy) so the volume is conserved.
#      Every a1 x a2 pair becomes y_E_in_1_2_bulk/y_dir/a1-<a1>-a2-<a2> (-pair: a1[i], a2[i]).
#
#  The cell constraint is a calc-file matter, not a workflow one: put it in y_full_relax
#  (VASP: ISIF=3 + Y_CONSTR_LATT modeid 3 relaxes sigma_33 only; LAMMPS: lmp.in rendered by
#  mymetal.build.workflow.lammps_input.generate_lmp_relax_input with box_relax='z').
#
#  It ONLY prepares input directories -- no Slurm script, no sbatch.

import argparse
import sys
from pathlib import Path

from mymetal.build.workflow.E_in_1_2_bulk import DICT_CALC_FILES, generate_E_in_1_2_bulk_dirs

EPILOG = """\
most common:
  pei_vasp_run_E_in_1_2_bulk -a1 2.90 2.95 3.00 -a2 2.90 2.95 3.00
                                                   # 3 x 3 grid (a0 ~ 2.95 here)
  pei_vasp_run_E_in_1_2_bulk -a1 2.90 2.95 3.00 -a2 2.95
                                                   # uniaxial along x, a2 pinned
  pei_vasp_run_E_in_1_2_bulk -a1 $(seq 2.70 0.01 2.90) -a2 $(seq 2.70 0.01 2.90) -pair
                                                   # equal biaxial only: a1 = a2, 21 dirs
  pei_vasp_run_E_in_1_2_bulk -calc lammps -a1 2.60 2.70 -a2 2.60 2.70
                                                   # LAMMPS: copies lmp.in, writes data.lmp
  pei_vasp_run_E_in_1_2_bulk -a1 2.60 2.70 -a2 2.60 2.70 -perturb 0.01 \\
                             -outdir y_E_in_1_2_bulk_perturb
                                                   # same grid, +-0.01 A random displacement

then:
  submit <outdir>/y_dir/* with your usual flow
  (VASP: pei_vasp_univ_sbatch; LAMMPS: pei_lmp_univ_sbatch), then
  cd <outdir> && pei_vasp_plot_E_in_1_2_bulk.py [-calc lammps]

notes:
  run at the level of y_full_relax; -a1 / -a2 are absolute lengths (a0-based), not strains.
  the full grid of two n-value lists is n*n dirs; -pair keeps n.
  -calc vasp copies INCAR KPOINTS POTCAR (+ sub.* Y_* CHGCAR); -calc lammps copies lmp.in
  (+ sub.*). POSCAR is written either way.
  -perturb draws a fresh seed and records it in <outdir>/y_perturb_seed.txt.
"""

parser = argparse.ArgumentParser(
    description="Generate uniaxial / biaxial in-plane stretch directories from y_full_relax.",
    epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("-a1", type=float, nargs="+", required=True,
                    help="Target x lattice lengths, Angstrom.")
parser.add_argument("-a2", type=float, nargs="+", required=True,
                    help="Target y lattice lengths, Angstrom.")
parser.add_argument("-pair", action="store_true",
                    help="Pair a1[i] with a2[i] instead of building every combination.")
parser.add_argument("-calc", default="vasp", choices=sorted(DICT_CALC_FILES),
                    help="Calc files to copy into each case (default vasp).")
parser.add_argument("-perturb", type=float, default=0.0,
                    help="Uniform random displacement amplitude per coordinate, Angstrom "
                         "(default 0, off).")
parser.add_argument("-srcdir", default="y_full_relax", help="Reference directory.")
parser.add_argument("-outdir", default="y_E_in_1_2_bulk", help="Output directory.")
parser.add_argument("-force", action="store_true",
                    help="Delete an existing output directory without prompting.")
args = parser.parse_args()
sys.stdout.reconfigure(line_buffering=True)

print("a1         :", " ".join("%.8f" % a for a in args.a1))
print("a2         :", " ".join("%.8f" % a for a in args.a2))
print("Pairing    :", "a1[i] with a2[i]" if args.pair else "every a1 x a2")
print("Calc files :", args.calc)
print("Perturb    :", ("±%g A" % args.perturb) if args.perturb > 0 else "off")
print("Source dir :", args.srcdir)
print("Output dir :", args.outdir)

path_root = Path.cwd().resolve()
print("🟢 ===== pei_vasp_run_E_in_1_2_bulk in %s" % path_root)
generate_E_in_1_2_bulk_dirs(path_root=path_root, la1=args.a1, la2=args.a2,
                            if_pair=args.pair, calc=args.calc, perturb=args.perturb,
                            srcdir=args.srcdir, outdir=args.outdir, force=args.force)
