# J. Pei, 2025-05-23
# Rewritten in Python by J. Pei, 2026-11-01 (same CLI and output; adds -calc lammps; the
#   logic lives in mymetal.build.workflow.neb)
# pei_vasp_run_neb
#  >>> dist.pl y_full_relax_neb/ini/CONTCAR y_full_relax_neb/fin/CONTCAR
#      3.117
#  >>> pei_vasp_run_neb 6      (3.117/0.8 is a good choice)
#
#  Run it at the level of y_full_relax_neb (ini/CONTCAR, fin/CONTCAR, templates *.neb in ini/).
#  It builds y_neb/y_dir/00 .. N+1 with nebmake.pl + nebavoid.pl 1 and copies the templates;
#  -calc lammps copies lmp.in.neb instead and writes data.lmp + coords.<i> from the same
#  images. Everything printed is also logged to y_neb/pei_vasp_run_neb.log. No sbatch.

import argparse
import shutil
import sys
from pathlib import Path

from mymetal.build.workflow.neb import DICT_NEB_TEMPLATES, generate_neb_dirs

EPILOG = """\
most common:
  dist.pl y_full_relax_neb/ini/CONTCAR y_full_relax_neb/fin/CONTCAR
  pei_vasp_run_neb 6                       # 6 images, VASP templates from ini/*.neb
  pei_vasp_run_neb 5 -calc lammps          # LAMMPS: ini/lmp.in.neb, data.lmp + coords.<i>

then:
  VASP:   cd y_neb/y_dir && sbatch sub.*   (copied from ini/sub.*.neb)
  LAMMPS: cd y_neb/y_dir && pei_lmp_univ_sbatch . lmp -partition <N+2>x1
          then pei_lmp_univ_post -neb

notes:
  recommended N_IMAGE = distance / 0.8 A. Existing y_neb: asks before deleting (-force skips).
  LAMMPS keeps the end replicas fixed, so ini / fin must already be relaxed.
"""


class Tee:
    """Duplicate stdout into a log file, as the bash version did with exec > >(tee log)."""

    def __init__(self, path_log, stream):
        self.file = open(path_log, "w")
        self.stream = stream

    def write(self, text):
        self.stream.write(text)
        self.file.write(text)

    def flush(self):
        self.stream.flush()
        self.file.flush()


parser = argparse.ArgumentParser(
    description="Generate and prepare NEB images from relaxed endpoints in y_full_relax_neb.",
    epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("n_image", type=int, metavar="N_IMAGE",
                    help="Number of intermediate images.")
parser.add_argument("-calc", default="vasp", choices=sorted(DICT_NEB_TEMPLATES),
                    help="Templates to copy from ini/ (default vasp).")
parser.add_argument("-srcdir", default="y_full_relax_neb", help="Endpoint directory.")
parser.add_argument("-outdir", default="y_neb", help="Output directory.")
parser.add_argument("-force", action="store_true",
                    help="Delete an existing output directory without prompting.")
args = parser.parse_args()
sys.stdout.reconfigure(line_buffering=True)

path_root = Path.cwd().resolve()
path_log = path_root / "pei_vasp_run_neb.log"
sys.stdout = Tee(path_log, sys.stdout)

print("🟢 ===== pei_vasp_run_neb in %s" % path_root)
print("📌 Command: %s" % " ".join(sys.argv))
print("Images     :", args.n_image)
print("Calc files :", args.calc)
print("Source dir :", args.srcdir)
print("Output dir :", args.outdir)

path_ydir = generate_neb_dirs(path_root=path_root, n_image=args.n_image, calc=args.calc,
                              srcdir=args.srcdir, outdir=args.outdir, force=args.force)

print("📄 Moving log file to: %s" % (path_ydir.parent / path_log.name))
sys.stdout.flush()
sys.stdout.file.close()
sys.stdout = sys.stdout.stream
shutil.move(str(path_log), str(path_ydir.parent / path_log.name))
