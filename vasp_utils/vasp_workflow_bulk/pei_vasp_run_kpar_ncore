#!/usr/bin/env python3
# J. Pei, 2026-07-15; retired 2026-09-01
# pei_vasp_run_kpar_ncore
#  >>> RETIRED. Merged into pei_vasp_run_convergence as one axis among five.
#
#  This workflow started as "scan KPAR and NCORE", then grew -klength / -encut / -ediff
#  flags until it was scanning five parameters under a name that promised two, wrote its
#  cases into a flat y_dir instead of the y_*/y_*_<axis>/y_dir layout every other bulk
#  workflow uses, and carried side flags (-encut/-ediff) that fought the project rule
#  that a case inherits everything from y_full_relax except the parameter under test.
#
#  pei_vasp_run_convergence now owns all five axes, each in its own subtree:
#      -encuts     y_convergence_encuts/y_dir/encut_<E>
#      -kpoints    y_convergence_kpoints/y_dir/kpoints_<n1>-<n2>-<n3>
#      -klengths   y_convergence_klength/y_dir/klen_<L>
#      -ediffs     y_convergence_ediff/y_dir/ediff_<D>
#      -kpar_ncore y_convergence_kpar_ncore/y_dir/kpar_<K>_ncore_<N>
#
#  The library it called, mymetal.build.workflow.kpar_ncore, is NOT retired: it still
#  supplies the source validation, the restart-free copy and the INCAR reader that
#  mymetal.build.workflow.convergence reuses. Finished y_kpar_ncore trees also still
#  post-process, via pei_vasp_plot_all -kpar_ncore.
#
#  Kept as a signpost rather than deleted so an old command line fails loudly with the
#  replacement in hand instead of "command not found".

import sys

GREEN, YELLOW, BLUE, NC = "\033[0;32m", "\033[0;33m", "\033[0;34m", "\033[0m"

print("%s❌ pei_vasp_run_kpar_ncore is retired.%s" % (YELLOW, NC))
print("")
print("   It scanned five parameters under a name that promised two, and wrote a flat")
print("   y_dir instead of the %sy_*/y_*_<axis>/y_dir%s layout the other bulk workflows use."
      % (BLUE, NC))
print("")
print("   Use %spei_vasp_run_convergence%s instead -- same source contract" % (GREEN, NC))
print("   (run it beside %sy_full_relax%s), one subtree per axis:" % (BLUE, NC))
print("")
print("     old: pei_vasp_run_kpar_ncore -pairs 4:4 8:4 -klength 81 -encut 400 -ediff 1E-6")
print("     new: %spei_vasp_run_convergence -kpar_ncore 4:4 8:4%s" % (GREEN, NC))
print("          ...with KPOINTS 'A 81', ENCUT 400 and EDIFF 1E-6 already set in")
print("          %sy_full_relax%s -- under the new workflow the source IS the reference"
      % (BLUE, NC))
print("          setting, and a case changes only the axis under test.")
print("")
print("     old: pei_vasp_run_kpar_ncore -pairs 4:4 -klength 60 81 100")
print("     new: %spei_vasp_run_convergence -klengths 60 81 100%s" % (GREEN, NC))
print("")
print("   See %spei_vasp_run_convergence --help%s for all five axes." % (GREEN, NC))
print("   Existing y_kpar_ncore trees still post-process: %spei_vasp_plot_all -kpar_ncore%s"
      % (GREEN, NC))
sys.exit(1)
